# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!scripts/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Configuration (contains secrets)
server-manager/config/config.yaml
photo-curator/config/config.yaml

# Docker Compose live env file (contains secrets — never commit)
# Commit docker/.env.example instead
docker/.env

# Data directories
server-manager/data/*.db
photo-curator/data/*.db
server-manager/data/*.db-*
photo-curator/data/*.db-*

# Logs
*.log
logs/

# Backups
backups/
*.sql
*.sql.gz

# Models
photo-curator/models/*.pth
photo-curator/models/*.onnx

# OS
.DS_Store
Thumbs.db

# State files (created during installation)
.install-state.json

# Temporary files
*.tmp
temp/
tmp/

# Node
node_modules/
server-manager/frontend/node_modules/
# Frontend build output is committed so deployment is just: git pull + restart
!server-manager/frontend/dist/
!photo-curator/frontend/dist/
