# =============================================================================
# HOMELAB DOCKER COMPOSE — MASTER ENVIRONMENT FILE
# =============================================================================
# Copy this file to docker/.env and fill in your values:
#   cp docker/.env.example docker/.env
#
# docker/.env is gitignored. Never commit the live .env file.
# =============================================================================

# Docker Compose project name — keeps all homelab containers grouped together
# in `docker ps` output and prevents name collisions with other stacks.
COMPOSE_PROJECT_NAME=homelab


# =============================================================================
# GPU ASSIGNMENT
# =============================================================================
# Each service that uses a GPU gets its own variable here.
# This means you can assign services to different GPUs (or the same GPU)
# without editing any compose file — just change the value and restart.
#
# To list your available GPUs:
#   nvidia-smi --query-gpu=index,name,uuid --format=csv
#
# Use the index ("0", "1") for simplicity, or the UUID
# ("GPU-abc123...") for stability after a hardware swap in Phase 3.
#
# Phase 3 hardware swap checklist:
#   1. Run nvidia-smi on the new hardware to get new indices/UUIDs
#   2. Update the relevant GPU_ID variables below
#   3. `docker compose ... up -d` to apply — no compose file edits needed

# GPU for Immich machine-learning inference (CLIP, facial recognition)
IMMICH_ML_GPU_ID=0

# GPU for Photo Curator batch processing (blur detection, scene classification, face recognition)
PHOTO_CURATOR_GPU_ID=1

# GPU for Jellyfin hardware transcoding (add when deploying Jellyfin)
# JELLYFIN_GPU_ID=0

# GPU for Ollama LLM inference (add when deploying Ollama)
# OLLAMA_GPU_ID=0


# =============================================================================
# IMMICH
# =============================================================================

# Immich version tag. Pin to a specific release (e.g. v1.117.0) to avoid
# surprise upgrades. Use "release" only in dev/test environments.
IMMICH_VERSION=release

# --- Database ---
# Strong, unique password. Generate with: openssl rand -base64 32
IMMICH_DB_PASSWORD=changeme_use_a_strong_password
IMMICH_DB_NAME=immich
IMMICH_DB_USERNAME=immich

# --- Storage paths ---
# IMMICH_UPLOAD_LOCATION is where Immich stores the actual photo/video files.
# In Phase 3 (mergerfs pool), set this to your mergerfs mount point, e.g.:
#   IMMICH_UPLOAD_LOCATION=/mnt/storage/immich/library
IMMICH_UPLOAD_LOCATION=./data/library

# Optional: path to a folder on the host that Immich can read as an
# external library (e.g. existing photos you don't want to re-import).
# Leave empty to disable.
IMMICH_EXTERNAL_PATH=

# --- Internal service URLs (do not change unless you rename containers) ---
IMMICH_REDIS_URL=redis://immich-redis:6379
IMMICH_DB_URL=postgresql://${IMMICH_DB_USERNAME}:${IMMICH_DB_PASSWORD}@immich-postgres/${IMMICH_DB_NAME}


# =============================================================================
# FUTURE SERVICES — uncomment and fill in when you add each service
# =============================================================================

# --- Nextcloud ---
# NEXTCLOUD_DB_PASSWORD=changeme
# NEXTCLOUD_ADMIN_USER=admin
# NEXTCLOUD_ADMIN_PASSWORD=changeme
# NEXTCLOUD_DATA_DIR=/mnt/storage/nextcloud/data

# --- Jellyfin ---
# JELLYFIN_MEDIA_DIR=/mnt/storage/media
# JELLYFIN_CONFIG_DIR=./data/jellyfin/config
# JELLYFIN_CACHE_DIR=./data/jellyfin/cache

# --- Ollama ---
# OLLAMA_MODELS_DIR=./data/ollama/models

# --- Reverse proxy (Caddy) ---
CADDY_ACME_EMAIL=you@example.com
BASE_DOMAIN=yourdomain.com   # documentation only — not interpolated in Caddyfile
