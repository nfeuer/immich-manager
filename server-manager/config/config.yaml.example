# Immich Server Manager Configuration

server:
  host: "127.0.0.1"  # Use "0.0.0.0" only if you need LAN access and have a reverse proxy/firewall
  port: 8080
  workers: 2
  log_level: "INFO"

immich:
  docker_compose_path: "/opt/immich"
  api_url: "http://localhost:2283/api"
  api_key: ""  # Generate in Immich: Admin → API Keys

storage:
  mergerfs_mount: "/mnt/storage"
  data_drives:
    - "/dev/sda"
    - "/dev/sdb"
  parity_drives:
    - "/dev/sdc"
  snapraid_config: "/etc/snapraid.conf"

backup:
  enabled: true
  local_path: "/mnt/backups/immich"
  schedule: "0 2 * * *"  # Daily at 2 AM
  retention_days: 30
  compression: true
  encryption:
    enabled: false
    public_key: ""

# Backup Verification System (Feature #12)
backup_verification:
  # Directory where backups are stored (same as backup.local_path)
  backup_dir: "/mnt/backups/immich"

  # Temporary directory for restore testing
  test_restore_dir: "/tmp/immich-restore-test"

  # Verification log location
  verification_log: "data/backup-verification.json"

  # Email notifications for verification failures
  email_notifications:
    enabled: true  # Send email if verification fails

  # Offsite sync (S3 or Backblaze B2)
  offsite_sync:
    enabled: false  # Set to true after configuring
    type: "s3"  # "s3" or "backblaze"

    # For AWS S3:
    bucket: "my-immich-backups"
    region: "us-east-1"
    access_key: ""  # AWS Access Key ID
    secret_key: ""  # AWS Secret Access Key

    # For Backblaze B2 (uncomment if using):
    # bucket: "my-immich-backups"
    # key_id: ""  # Backblaze Key ID
    # application_key: ""  # Backblaze Application Key

  # Retention policy (advanced backup management)
  retention_policy:
    daily: 7      # Keep 7 daily backups
    weekly: 4     # Keep 4 weekly backups (one per week)
    monthly: 12   # Keep 12 monthly backups (one per month)

monitoring:
  disk_check_interval: 300  # 5 minutes
  metrics_interval: 60      # 1 minute

thresholds:
  disk_temp_warning: 45
  disk_temp_critical: 50
  disk_space_warning: 85
  disk_space_critical: 95

alerts:
  email:
    enabled: true
    smtp_host: "smtp.gmail.com"
    smtp_port: 587
    smtp_user: "your-email@gmail.com"
    smtp_password: "your-app-password"
    from: "immich-server@yourdomain.com"
    to:
      - "admin@yourdomain.com"
  webhook:
    enabled: false
    url: ""
  quiet_hours:
    enabled: true
    start: "22:00"
    end: "08:00"
