# Immich Server Manager Configuration

server:
  host: "127.0.0.1"  # Use "0.0.0.0" only if you need LAN access and have a reverse proxy/firewall
  port: 8080
  workers: 2
  log_level: "INFO"

immich:
  # Path to the directory containing the compose files for your Immich stack.
  # With the multi-file layout introduced in docker/, pass both files to
  # any docker compose command run by this manager, e.g.:
  #   docker compose --env-file docker/.env -f docker/core.yml -f docker/immich.yml <subcommand>
  # Set docker_compose_files to the list of files in order, and
  # docker_compose_dir to the directory that contains them.
  docker_compose_dir: "/opt/homelab/docker"
  docker_compose_files:
    - "core.yml"
    - "immich.yml"
  # Immich HTTP API — reachable on the host via the 127.0.0.1:2283 binding
  # in immich.yml. When a reverse proxy is added and that binding is removed,
  # update this URL to point through the proxy instead.
  api_url: "http://localhost:2283/api"
  api_key: "${IMMICH_API_KEY:-}"  # Generate in Immich: Admin → API Keys. Use env var or paste directly.

storage:
  mergerfs_mount: "/mnt/storage"
  data_drives:
    - "/dev/sda"
    - "/dev/sdb"
  parity_drives:
    - "/dev/sdc"
  snapraid_config: "/etc/snapraid.conf"

backup:
  enabled: true
  local_path: "/mnt/backups/immich"
  schedule: "0 2 * * *"  # Daily at 2 AM
  retention_days: 30
  compression: true
  encryption:
    enabled: false
    public_key: ""

# Backup Verification System (Feature #12)
backup_verification:
  # Directory where backups are stored (same as backup.local_path)
  backup_dir: "/mnt/backups/immich"

  # Temporary directory for restore testing
  test_restore_dir: "/tmp/immich-restore-test"

  # Verification log location
  verification_log: "data/backup-verification.json"

  # Email notifications for verification failures
  email_notifications:
    enabled: true  # Send email if verification fails

  # Offsite sync (S3 or Backblaze B2)
  offsite_sync:
    enabled: false  # Set to true after configuring
    type: "s3"  # "s3" or "backblaze"

    # For AWS S3:
    bucket: "my-immich-backups"
    region: "us-east-1"
    access_key: "${AWS_ACCESS_KEY_ID:-}"
    secret_key: "${AWS_SECRET_ACCESS_KEY:-}"

    # For Backblaze B2 (uncomment if using):
    # bucket: "my-immich-backups"
    # key_id: "${B2_KEY_ID:-}"
    # application_key: "${B2_APPLICATION_KEY:-}"

  # Retention policy (advanced backup management)
  retention_policy:
    daily: 7      # Keep 7 daily backups
    weekly: 4     # Keep 4 weekly backups (one per week)
    monthly: 12   # Keep 12 monthly backups (one per month)

auto_update:
  enabled: false              # Set to true to enable the auto-updater
  apply_patch_updates: false  # Auto-apply patch bumps (e.g. 1.99.0 → 1.99.1)
                              # Minor (1.Y.z) and major (X.y.z) bumps always require
                              # manual approval via POST /api/updates/apply
  # Multi-file compose layout: both files must be passed to the updater.
  # Match these values to the paths where you deploy the docker/ directory.
  docker_compose_dir: "/opt/homelab/docker"
  docker_compose_files:
    - "core.yml"
    - "immich.yml"
  snapshot_retention_days: 7           # Days to keep pre-update snapshots
  health_check_timeout: 120            # Seconds to wait for Immich to come back healthy

monitoring:
  disk_check_interval: 300  # 5 minutes
  metrics_interval: 60      # 1 minute
  gpu_check_interval: 10    # seconds — short enough to catch transient PSU spikes
  system_power_baseline_watts: 65.0  # mobo + drives + fans (used when IPMI/hwmon unavailable)
  psu_efficiency: 0.92      # AC↔DC conversion. Corsair RMx Platinum ≈ 0.92 at typical loads.

thresholds:
  disk_temp_warning: 45
  disk_temp_critical: 50
  disk_space_warning: 85
  disk_space_critical: 95
  gpu_temp_warning: 80
  gpu_temp_critical: 90
  # PSU headroom alerts. Set psu_watts to your PSU's rated DC output wattage.
  # Compared against the DC component sum (CPU + GPUs + baseline), so
  # efficiency losses don't inflate the percentage.
  psu_watts: 750         # Corsair RM750x Platinum
  psu_warning_percent: 80
  psu_critical_percent: 95

auth:
  default_role: "user"  # Role assigned to new users: "admin", "user", or "guest"

# IP Gate — centralized IP verification and monitoring
ip_gate:
  enabled: true
  trusted_proxy_ips:
    - "127.0.0.1"
    - "172.17.0.1"  # Docker bridge
  token_expiry_minutes: 15
  email_rate_limit: "3/15minutes"
  verification_rate_limit: "5/15minutes"
  admin_email: "admin@yourdomain.com"  # fallback alert recipient
  cloudflare:
    enabled: false  # requires Teams Standard plan
    api_token: "${CLOUDFLARE_API_TOKEN:-}"
    account_id: ""
    list_name: "immich-trusted-ips"
    reconciliation_interval_hours: 6

alerts:
  email:
    enabled: true
    smtp_host: "smtp.gmail.com"
    smtp_port: 587
    smtp_user: "${SMTP_USER:-your-email@gmail.com}"
    smtp_password: "${SMTP_PASSWORD}"  # Use env var: export SMTP_PASSWORD='your-app-password'
    from: "immich-server@yourdomain.com"
    to:
      - "admin@yourdomain.com"
  webhook:
    enabled: false
    url: ""
  discord:
    enabled: false
    webhook_url: "${DISCORD_WEBHOOK_URL:-}"  # Discord channel webhook URL
    bot_name: "Immich Manager"              # Display name in Discord
    server_name: ""                          # Optional: label for this server
  quiet_hours:
    enabled: true
    start: "22:00"
    end: "08:00"
  digest:
    enabled: false                   # Enable scheduled Discord digest summaries
    schedule: "0 9 * * *"           # Cron expression (default: daily at 9 AM)
    sections:                        # Which sections to include in the digest
      - system                       # CPU, memory, disk usage
      - storage                      # Per-drive SMART health summary
      - backups                      # Recent backup status
      - containers                   # Immich container health
      - alerts                       # Unacknowledged alert counts
