[Unit]
Description=Immich Server Manager
After=network.target docker.service
Requires=docker.service

[Service]
Type=notify
User=immich-mgr
Group=immich-mgr
WorkingDirectory=/opt/immich-server-manager
Environment="PATH=/opt/immich-server-manager/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/etc/immich-ecosystem/secrets.env
ExecStart=/opt/immich-server-manager/venv/bin/python -m uvicorn src.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=10
WatchdogSec=60

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/immich-server-manager /var/log/immich-ecosystem
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=immich-server-manager

[Install]
WantedBy=multi-user.target
