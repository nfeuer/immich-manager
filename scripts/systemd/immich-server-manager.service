[Unit]
Description=Immich Server Manager
After=network.target docker.service
Requires=docker.service

[Service]
Type=notify
User=root
WorkingDirectory=/opt/immich-server-manager
Environment="PATH=/opt/immich-server-manager/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/immich-server-manager/venv/bin/python -m uvicorn src.main:app --host 127.0.0.1 --port 8080 --workers 2
Restart=always
RestartSec=10
WatchdogSec=60

# Security settings
NoNewPrivileges=false
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=immich-server-manager

[Install]
WantedBy=multi-user.target
