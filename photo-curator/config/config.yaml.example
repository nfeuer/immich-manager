# Photo Curator Configuration

server:
  host: "127.0.0.1"  # Use "0.0.0.0" only if you need LAN access and have a reverse proxy/firewall
  port: 8081
  workers: 2

immich:
  # Base URL for Immich (used for SSO authentication)
  base_url: "http://localhost:2283"

  # API URL for backend requests
  api_url: "http://localhost:2283/api"

  # API key (OPTIONAL - only needed for admin background jobs)
  # Users authenticate via Immich SSO, so this is only for system tasks
  api_key: "${IMMICH_API_KEY:-}"  # Same as Server Manager (optional). Use env var or paste directly.

auth:
  default_role: "user"                  # Role for new Immich users: "admin", "user", or "guest"
  guest_link_default_expiry_days: 30    # Default expiration for guest share links (0 = no expiry)

ai:
  use_local_models: true
  model_path: "models/"
  batch_size: 10
  quality_threshold: 0.6

scoring:
  weights:
    technical_quality: 0.3
    faces: 0.3
    uniqueness: 0.2
    aesthetic: 0.2

curation:
  monthly_target: 50  # Target photos per month (default for new users)
  reminder_day: 1     # 1st of month (fixed, not configurable)
  reminder_time: "09:00"  # Time to send daily check for monthly reminders (HH:MM format)

notifications:
  email:
    enabled: true
    smtp_host: "smtp.gmail.com"
    smtp_port: 587
    smtp_user: "${SMTP_USER:-your-email@gmail.com}"
    smtp_password: "${SMTP_PASSWORD}"  # Use env var: export SMTP_PASSWORD='your-app-password'
    from: "photo-curator@yourdomain.com"

batch_processing:
  enabled: true

  # Scheduled automatic runs (in addition to manual trigger)
  schedule:
    enabled: false
    time_window_start: "23:00"   # 24h format — only run within this window
    time_window_end:   "06:00"   # Supports overnight windows (e.g., 23:00-06:00)

  # Cadence / throttle controls — protect system from sustained load
  cadence:
    batch_size: 25               # Photos analyzed per batch
    delay_between_batches: 5     # Seconds to rest between batches
    max_cpu_percent: 80          # Pause processing if overall CPU% exceeds this

  # GPU acceleration (GTX 1080 or similar)
  gpu:
    enabled: true
    device: "cuda:0"             # Change to "cpu" to force CPU-only mode

  # Error failsafe
  errors:
    batch_failure_percent: 50    # % of photos failed = batch counts as "failed"
    max_consecutive_failures: 3  # Pause job if this many consecutive batches fail

  # Default processing mode for scheduled runs
  default_mode: "incremental"    # incremental | missing_vectors | full | retry_errors

# Server Manager URL — Photo Curator delegates IP gate checks here.
# Must match the URL where Server Manager is running.
server_manager_url: "http://localhost:8080"
